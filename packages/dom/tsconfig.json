{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "target": "ES2020",
    "lib": [
      "ES2020",
      "DOM"
    ],
    "paths": {
      "quon/jsx-runtime": [
        "./src/jsx-runtime.ts"
      ],
      "quon/jsx-dev-runtime": [
        "./src/jsx-dev-runtime.ts"
      ],
      "quon": [
        "./src/index.ts"
      ]
    },
    "noEmit": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "jsxImportSource": "quon"
  },
  "include": [
    "src/**/*",
    "example/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
